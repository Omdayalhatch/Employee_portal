@page "/Department"
@using EmployeePortal.Application.Interface.IService
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService

@inject IDepartmentService DepartmentService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold">
            <i class="bi bi-building"></i> Department Management
        </h3>

        <button class="btn btn-success"
                @onclick="AddDepartment">
            <i class="bi bi-plus-circle"></i> Add Department
        </button>

    </div>


    @if (departments == null || departments.Count == 0)
    {
        <div class="card shadow-sm text-center p-5">

            <i class="bi bi-building display-4 text-secondary"></i>

            <h4 class="mt-3">No Department Found</h4>

            <button class="btn btn-primary mt-3"
                    @onclick="AddDepartment">
                Add First Department
            </button>

        </div>
    }
    else
    {

        <div class="card shadow-sm">

            <div class="card-body">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>DeptID</th>
                            <th>Department Name</th>
                            <th style="width:160px">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var dept in departments)
                        {
                            <tr>

                                <td>@dept.Id</td>

                                <td >
                                    @dept.DepartmentName
                                </td>

                                <td>

                                    <button class="btn btn-sm btn-warning me-2"
                                            @onclick="@(() => Edit(dept.Id))">
                                        ✏
                                        @* <i class="bi bi-pencil"></i> *@
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="@(() => Delete(dept.Id))">
                                        🗑
                                        @* <i class="bi bi-trash"></i> *@
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    }

</div>


@code {

    private List<DepartmentDTO> departments = new();

    protected override async Task OnInitializedAsync()
    {
        departments = (await DepartmentService.GetAllAsync()).ToList();
    }

    void AddDepartment()
    {
        Nav.NavigateTo("/Department/Create");
    }

    void Edit(int id)
    {
        Nav.NavigateTo($"/Department/Edit/{id}");
    }

    async Task Delete(int id)
    {

        var confirm = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this department?");

        if (!confirm)
            return;

        await DepartmentService.DeleteAsync(id);

        departments = (await DepartmentService.GetAllAsync()).ToList();
    }

}
