@page "/Designation"
@using EmployeePortal.Application.DTO
@using EmployeePortal.Application.Interface.IService
@inject IDesignationService DesignationService
@inject NavigationManager Nav
@inject IJSRuntime JS
<div class="container mt-4">
    <div class="card shadow badge-0 rounded-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">

                    <div>
                        <h5 class="fw-bold mb-0">🏷️ Designation Management</h5>
                        <small class="text-muted">Manage designations</small>
                    </div>

                    <div class="d-flex gap-2">

                        <input class="form-control"
                               style="width:250px"
                               placeholder="Search designation..."
                               @bind="searchText" />

                        <button class="btn btn-primary"
                                @onclick="Add">
                            ➕ Add Designation
                        </button>

                    </div>
                </div>

        <div class="card-body p-0">

            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary"></div>
                    <p>Loading...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-striped align-middle mb-0">

                        <thead class="table-light text-center">
                            <tr>
                                <th>ID</th>
                                <th class="text-start">Designation</th>
                                <th>Department</th>
                                <th style="width:150px">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!FilteredDesignations.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        🚫 No designation found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var d in FilteredDesignations)
                                {
                                    <tr class="text-center">

                                        <td>@d.Id</td>

                                        <td class="text-start fw-semibold">
                                            @d.DesignationName
                                        </td>

                                        <td>@d.DepartmentName</td>

                                        <td>

                                            <button class="btn btn-sm btn-warning me-1"
                                                    title="Edit"
                                                    @onclick="@(() => Edit(d.Id))">
                                                ✏️
                                            </button>

                                            <button class="btn btn-sm btn-danger"
                                                    title="Delete"
                                                    @onclick="@(() => Delete(d.Id))">
                                                🗑️
                                            </button>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>
</div>

@code {

    private List<DesignationDTO> designations = new();
    private string searchText = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        designations = (await DesignationService.GetAllAsync()).ToList();
        isLoading = false;
    }

    IEnumerable<DesignationDTO> FilteredDesignations =>
        string.IsNullOrWhiteSpace(searchText)
        ? designations
        : designations.Where(d =>
            (d.DesignationName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (d.DepartmentName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase));

    void Add()
    {
        Nav.NavigateTo("/Designation/Create");
    }

    void Edit(int id)
    {
        Nav.NavigateTo($"/Designation/Edit/{id}");
    }

    private async Task Delete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            "Delete this designation?");

        if (!confirm)
            return;

        var success = await DesignationService.DeleteAsync(id);

        if (!success)
        {
            await JS.InvokeVoidAsync("alert",
                "❌ Cannot delete. It is assigned to employees.");
            return;
        }

        designations.RemoveAll(d => d.Id == id);

        await JS.InvokeVoidAsync("alert", "✅ Deleted successfully");
    }

}