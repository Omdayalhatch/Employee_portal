@page "/Employee/Create"

@using EmployeePortal.Application.DTO
@using EmployeePortal.Application.Interface.IService
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@inject IDesignationService DesignationService
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IUserService UserService
@inject NavigationManager Nav

<div class="container my-4">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-gradient bg-primary text-white rounded-top-4">
            <h4 class="mb-0">
                👤 Add New Employee
            </h4>
        </div>

        <div class="card-body p-4">

            <EditForm Model="model" OnValidSubmit="Save">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    

                    <div class="col-md-6 mb-3">
                        <label class="form-label">First Name</label>

                        <InputText class="form-control"
                                   @bind-Value="model.FirstName" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Last Name</label>

                        <InputText class="form-control"
                                   @bind-Value="model.LastName" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Contact</label>

                        <InputText class="form-control"
                                   @bind-Value="model.Contact" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender</label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.Gender">

                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>

                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Department</label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.DepartmentId">

                            <option value="0">Select Department</option>

                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.DepartmentName</option>
                            }

                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Designation</label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.DesignationId">

                            <option value="0">Select Designation</option>

                            @foreach (var d in allDesignations)
                            {
                                <option value="@d.Id">@d.DesignationName</option>
                            }

                        </InputSelect>
                    </div>


                  @*   <div class="col-md-6 mb-3">
                        <label class="form-label">User Account</label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.UserId">

                            <option value="">Select User</option>

                            @foreach (var u in users)
                            {
                                <option value="@u.Id">
                                    @u.UserName
                                </option>
                            }

                        </InputSelect>
                    </div> *@

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date Of Birth</label>

                        <InputDate class="form-control"
                                   @bind-Value="model.DateofBirth" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Salary *</label>
                        <InputNumber class="form-control" @bind-Value="model.Salary" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Joining Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="model.JoiningDate" />
                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">Address</label>

                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="model.Address" />

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Profile Image 
                        </label>

                        <InputFile class="form-control"
                                   onchange="UploadProfile"
                                   @bind-Value="model.Profile" />

                    </div>

                    @if (!string.IsNullOrEmpty(model.Profile))
                    {
                        <div class="col-md-12 text-center mb-3">

                            <img src="@model.Profile"
                                 style="height:150px;border-radius:12px;box-shadow:0 0 10px gray;" />

                        </div>
                    }

                </div>

                <div class="mt-3 justify-content-end d-flex">

                    <button class="btn btn-success me-2 px-4"
                            type="submit">

                        💾 Save Employee

                    </button>

                    <button class="btn btn-outline-secondary px-4 "
                            type="button"
                            @onclick="Back">

                        Cancel

                    </button>

                </div>

            </EditForm>

        </div>

    </div>

</div>

@code {

    private EmployeeDTO model = new();

    private List<DepartmentDTO> departments = new();
    // private List<UserDTO> users = new();
    private List<DesignationDTO> allDesignations = new();
    private async Task UploadProfile(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null)
        {
            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif" };
            if (!allowedTypes.Contains(file.ContentType))
            {
                return;
            }

            var fileName = $"{Guid.NewGuid()}_{file.Name}";
            var savePath = Path.Combine("wwwroot/uploads", fileName);

            using var fs = new FileStream(savePath, FileMode.Create);
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs); 

            model.Profile = $"/uploads/{fileName}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        departments = (await DepartmentService.GetAllAsync()).ToList();

        // users = await UserService.GetAllUsersAsync();
        allDesignations = (await DesignationService.GetAllAsync()).ToList();
    }

    // private void OnDepartmentChanged(ChangeEventArgs e)
    // {
    //     if (int.TryParse(e.Value?.ToString(), out int deptId))
    //     {
    //         model.DepartmentId = deptId;

    //         designations = allDesignations
    //             .Where(d => d.DepartmentId == deptId)
    //             .ToList();
    //     }
    // }


    private async Task Save()
    {
        await EmployeeService.CreateAsync(model);

        Nav.NavigateTo("/Employee");
    }

    void Back()
    {
        Nav.NavigateTo("/Employee");
    }

}