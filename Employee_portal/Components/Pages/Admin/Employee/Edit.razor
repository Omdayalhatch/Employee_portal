@page "/Employee/Edit/{Id:int}"

@using EmployeePortal.Application.DTO
@using EmployeePortal.Application.Interface.IService
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@inject IDesignationService DesignationService
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IUserService UserService
@inject NavigationManager Nav

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Edit Employee</h4>
        </div>

        <div class="card-body">

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p>Loading Employee...</p>
                </div>
            }
            else
            {

                <EditForm Model="model" OnValidSubmit="Update">
                    <DataAnnotationsValidator />
                    @* <ValidationSummary /> *@

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name</label>
                            <InputText class="form-control" @bind-Value="model.FirstName" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <InputText class="form-control" @bind-Value="model.LastName" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact</label>
                            <InputText class="form-control" @bind-Value="model.Contact" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender</label>
                            <InputSelect class="form-select" @bind-Value="model.Gender">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department</label>
                            <InputSelect class="form-select" @bind-Value="model.DepartmentId" @onchange="OnDepartmentChanged">
                                <option value="0">Select Department</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Designation</label>
                            <InputSelect class="form-select" @bind-Value="model.DesignationId">
                                <option value="0">Select Designation</option>
                                @foreach (var d in filteredDesignations)
                                {
                                    <option value="@d.Id">@d.DesignationName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">Profile Image</label>
                            <InputFile class="form-control" OnChange="UploadProfile" />
                        </div>

                        @if (!string.IsNullOrEmpty(model.Profile))
                        {
                            <div class="col-md-12 text-center mb-3">
                                <img src="@model.Profile" style="height:150px;border-radius:12px;box-shadow:0 0 10px gray;" />
                            </div>
                        }

                    </div>

                    <div class="mt-3">
                        <button class="btn btn-success" type="submit" disabled="@isSaving">
                            @(isSaving ? "Updating..." : "Update Employee")
                        </button>
                        <button class="btn btn-secondary" type="button" @onclick="Back">Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    EmployeeDTO model = new();
    List<DepartmentDTO> departments = new();
    List<DesignationDTO> allDesignations = new();
    List<DesignationDTO> filteredDesignations = new();
    bool isSaving = false;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        model = await EmployeeService.GetByIdAsync(Id);

        departments = (await DepartmentService.GetAllAsync()).ToList();
        allDesignations = (await DesignationService.GetAllAsync()).ToList();

        filteredDesignations = allDesignations
                                .Where(d => d.DepartmentId == model.DepartmentId)
                                .ToList();

        isLoading = false;
    }

    private void OnDepartmentChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int deptId))
        {
            model.DepartmentId = deptId;
            filteredDesignations = allDesignations
                                    .Where(d => d.DepartmentId == deptId)
                                    .ToList();
            model.DesignationId = 0; 
        }
    }

    private async Task UploadProfile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif" };
        if (!allowedTypes.Contains(file.ContentType)) return;

        var fileName = $"{Guid.NewGuid()}_{file.Name}";
        var savePath = Path.Combine("wwwroot/uploads", fileName);

        Directory.CreateDirectory(Path.GetDirectoryName(savePath));

        using var fs = new FileStream(savePath, FileMode.Create);
        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);

        model.Profile = $"/uploads/{fileName}";
    }

    async Task Update()
    {
        isSaving = true;
        try
        {
            await EmployeeService.UpdateAsync(model);
            Nav.NavigateTo("/Employee");
        }
        finally
        {
            isSaving = false;
        }
    }

    void Back() => Nav.NavigateTo("/Employee");
}