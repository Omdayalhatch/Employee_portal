@page "/Employee"
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@inject IEmployeeService EmployeeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container-fluid mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-people"></i> Employee Management
            </h5>

            <div class="d-flex gap-2">

                <input class="form-control"
                       style="width:250px"
                       placeholder="Search employee..."
                       @bind="searchText" />

                <button class="btn btn-success"
                        @onclick="AddEmployee">
                    <i class="bi bi-plus-circle"></i> Add
                </button>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr class="text-center">
                            <th>ID</th>
                            <th class="text-start">Employee</th>
                            <th>Department</th>
                            <th>DOB</th>
                            <th>Gender</th>
                            <th style="width:140px">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var employee in FilterEmployees())
                        {
                            <tr class="text-center">

                                <td>@employee.Id</td>

                                <td class="text-start">

                                    <div class="d-flex align-items-center gap-2">

                                        @if (!string.IsNullOrEmpty(employee.Profile))
                                        {
                                            <img src="@employee.Profile"
                                                 class="emp-img" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle fs-3 text-secondary"></i>
                                        }

                                        <div>
                                            <div class="fw-semibold">
                                                @employee.FirstName @employee.LastName
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                        @employee.DepartmentName
                                </td>

                                <td>
                                    @employee.DateofBirth.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                        @employee.Gender
                                </td>

                                <td>

                                    <button class="btn btn-sm btn-warning me-1"
                                            @onclick="@(() => Edit(employee.Id))">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="@(() => Delete(employee.Id))">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>

    .emp-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #eee;
    }

    table tbody tr:hover {
        background: #f8f9ff;
        transition: .2s;
    }

    .card-header {
        background: white;
    }

</style>

@code {

    private List<EmployeeDTO> employees = new();
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetAllAsync()).ToList();
    }

    IEnumerable<EmployeeDTO> FilterEmployees()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return employees;

        return employees.Where(e =>
            e.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            e.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            e.DepartmentName.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    void AddEmployee()
    {
        Nav.NavigateTo("/Employee/Create");
    }

    void Edit(int id)
    {
        Nav.NavigateTo($"/Employee/Edit/{id}");
    }

    private async Task Delete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this employee?");

        if (!confirm)
            return;

        var response = await EmployeeService.DeleteAsync(id);

        if (!response)
        {
            await JS.InvokeVoidAsync("alert",
                "Employee cannot be deleted due to related records.");
            return;
        }

        employees = (await EmployeeService.GetAllAsync()).ToList();
    }

}