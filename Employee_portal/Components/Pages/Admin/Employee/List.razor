@page "/Employee"
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@inject IEmployeeService EmployeeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container-fluid mt-3">

    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">

        <h4 class="fw-bold m-0">👥 Employee Management</h4>

        <div class="d-flex gap-2 align-items-center flex-wrap">

            <input class="form-control"
                   style="width: 220px; height: 38px;"
                   placeholder="Search employee..."
                   value="@searchText"
                   @oninput="OnSearchChanged" />

            <button class="btn btn-primary"
                    style="height: 38px;"
                    @onclick="AddEmployee">
                ➕ Add
            </button>

            <button class="btn btn-success"
                    style="height: 38px;"
                    @onclick="DownloadReport">
                ⬇ Export
            </button>

        </div>
    </div>

    <div class="card shadow rounded-4">
        <div class="card-body p-0 " >

            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Loading employees...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee-ID</th>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>DOB</th>
                                <th>Gender</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (!PagedEmployees.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        🚫 No data found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in PagedEmployees)
                                {
                                    
                                    <tr>
                                        <td>@emp.Id</td>

                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(emp.Profile))
                                                {
                                                    <img src="@emp.Profile" class="emp-img" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person-circle fs-3 text-secondary"></i>
                                                }

                                                <div>
                                                    <div>@emp.FirstName @emp.LastName</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>@emp.DepartmentName</td>
                                        <td>@emp.DesignationName</td>
                                        <td>@emp.DateofBirth.ToString("dd MMM yyyy")</td>
                                        <td>@emp.Gender</td>

                                        <td>
                                            <button class="btn btn-sm btn-warning me-1" @onclick="() => Edit(emp.Id)">✏</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(emp.Id)">🗑</button>
                                        </td>
                                    </tr>
                        
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center p-3 flex-wrap gap-2">

        <small>Page @currentPage of @TotalPages</small>

        <div class="d-flex flex-wrap gap-1">

            <button class="btn btn-sm btn-outline-primary"
                    disabled="@(currentPage == 1)"
                    @onclick="() => ChangePage(currentPage - 1)">
                Prev
            </button>
            @foreach (var page in GetVisiblePages())
            {
                <button class="btn btn-sm @(page == currentPage ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => ChangePage(page)">
                    @(page) 
                </button>
            }

            <button class="btn btn-sm btn-outline-primary"
                    disabled="@(currentPage == TotalPages)"
                    @onclick="() => ChangePage(currentPage + 1)">
                Next
            </button>

        </div>
    </div>
}
            }
        </div>
    </div>
</div>

<style>
    .emp-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #ddd;
    }
    table tbody tr:hover {
        background: #f5f7ff;
         transition: 0.2s; 
    }    
</style>

@code {
    private List<EmployeeDTO> employees = new();
    private List<EmployeeDTO> filteredList = new();

    private string searchText = "";
    private bool isLoading = true;

    private int currentPage = 1;
    private int pageSize = 7;

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetAllAsync()).ToList();
        filteredList = employees;
        isLoading = false;
    }

    private int TotalPages => (int)Math.Ceiling((double)filteredList.Count / pageSize);

    IEnumerable<EmployeeDTO> PagedEmployees =>
        filteredList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    
    private void ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;

        currentPage = page;
        StateHasChanged(); 
    }

    private List<int> GetVisiblePages()
    {
        int maxPagesToShow = 5;

        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(TotalPages, start + maxPagesToShow - 1);

        if (end - start < maxPagesToShow)
        {
            start = Math.Max(1, end - maxPagesToShow + 1);
        }

        return Enumerable.Range(start, end - start + 1).ToList();
    }
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";

        filteredList = string.IsNullOrWhiteSpace(searchText)
            ? employees
            : employees.Where(e =>
                (e.FirstName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.LastName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.DepartmentName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.DesignationName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase)
            ).ToList();

        currentPage = 1;
    }

    private void AddEmployee()
    {
        Nav.NavigateTo("/Employee/Create");
    }

    private void Edit(int id)
    {
        Nav.NavigateTo($"/Employee/Edit/{id}");
    }

    private async Task ConfirmDelete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure to delete?");
        if (confirm)
        {
            await Delete(id);
        }
    }

    private async Task Delete(int id)
    {
        await EmployeeService.DeleteAsync(id);

        employees = employees.Where(e => e.Id != id).ToList();
        filteredList = filteredList.Where(e => e.Id != id).ToList();

        if (currentPage > TotalPages)
            currentPage = TotalPages;
    }

    private async Task DownloadReport()
    {
        var csv = new System.Text.StringBuilder();

        csv.AppendLine("ID,Name,Department,Designation,DOB,Gender");

        foreach (var emp in filteredList)
        {
            var dob = emp.DateofBirth.ToString("dd-MM-yyyy");

            csv.AppendLine($"{emp.Id},\"{emp.FirstName} {emp.LastName}\",\"{emp.DepartmentName}\",\"{emp.DesignationName}\",\"{dob}\",\"{emp.Gender}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFile", "Employees.csv", base64);
    }
}