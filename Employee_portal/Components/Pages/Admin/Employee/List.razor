@page "/Employee"
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@inject IEmployeeService EmployeeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">
            <i class="bi bi-people"></i> Employee Management
        </h3>

        <button class="btn btn-success"
                @onclick="AddEmployee">
            <i class="bi bi-plus-circle"></i> Add Employee
        </button>
    </div>

    @if (employees == null || employees.Count == 0)
    {
        <div class="card shadow-sm text-center p-5">

            <i class="bi bi-people display-4 text-secondary"></i>

            <h4 class="mt-3">No Employee Found</h4>

            <p class="text-muted">
                Start by adding your first employee to the system.
            </p>

            <button class="btn btn-primary mt-2"
                    @onclick="AddEmployee">
                Add First Employee
            </button>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <table class="table table-hover align-middle text-center">

                    <thead class="table-dark">
                        <tr>
                            <th>Profile</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Department</th>
                            <th>Date Of Birth</th>
                            <th>Gender</th>
                            <th style="width:170px">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var employee in employees)
                        {
                            <tr>

                                <td>
                                    @if (!string.IsNullOrEmpty(employee.Profile))
                                    {
                                        <img src="@employee.Profile"
                                             style="height:60px;width:60px;border-radius:50%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-3 text-secondary"></i>
                                    }
                                </td>

                                <td class="fw-semibold">@employee.FirstName</td>

                                <td>@employee.LastName</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @employee.DepartmentName
                                    </span>
                                </td>

                                <td>
                                    @employee.DateofBirth.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @employee.Gender
                                    </span>
                                </td>

                                <td>

                                    <button class="btn btn-sm btn-warning me-2"
                                            @onclick="@(() => Edit(employee.Id))">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="@(() => Delete(employee.Id))">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


@code {

    private List<EmployeeDTO> employees = new();

    protected override async Task OnInitializedAsync()
    {
        employees = (await EmployeeService.GetAllAsync()).ToList();
    }

    void AddEmployee()
    {
        Nav.NavigateTo("/Employee/Create");
    }

    void Edit(int id)
    {
        Nav.NavigateTo($"/Employee/Edit/{id}");
    }

    private async Task Delete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this employee?");

        if (!confirm)
            return;

        var response = await EmployeeService.DeleteAsync(id);

        if (!response)
        {
            await JS.InvokeVoidAsync("alert",
                "Employee cannot be deleted due to related records.");
            return;
        }

        employees = (await EmployeeService.GetAllAsync()).ToList();
    }

}