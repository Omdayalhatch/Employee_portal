@page "/Dashboard"
@using EmployeePortal.Infrastucture.Data
@using EmployeeProtal.Domain.Entities
@using Microsoft.EntityFrameworkCore


@inject AppDbContext Db

<div class="dashboard-wrapper">

    

    <div class="greeting">
        <h3>Hello Admin 👋</h3>
        <p>Welcome back to your Employee Portal Dashboard</p>
    </div>

    <div class="stats">

        <div class="stat-card blue">
            <i class="bi bi-people"></i>
            <div>
                <h5>Total Employees</h5>
                <h2>@totalEmployees</h2>
            </div>
        </div>

        <div class="stat-card green">
            <i class="bi bi-building"></i>
            <div>
                <h5>Total Departments</h5>
                <h2>@totalDepartments</h2>
            </div>
        </div>

        <div class="stat-card purple">
            <i class="bi bi-person-badge"></i>
            <div>
                <h5>Total Designations</h5>
                <h2>@totalDesignations</h2>
            </div>
        </div>

        <div class="stat-card red">
            <i class="bi bi-calendar-x"></i>
            <div>
                <h5>Leave Requests</h5>
                <h2>@totalLeaves</h2>
            </div>
        </div>

    </div>

    <div class="tables">

        <div class="card">

            <div class="card-header">
                Recent Employees
            </div>

            <table>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Joining</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var e in recentEmployees)
                    {
                        <tr>
                            <td>@e.FirstName @e.LastName</td>
                            <td>@e.Department?.DepartmentName</td>
                            <td>@e.JoiningDate.ToShortDateString()</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
        <div class="card">

            <div class="card-header">
                Latest Leave Requests
            </div>

            <table>

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>From</th>
                        <th>To</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var l in recentLeaves)
                    {
                        <tr>
                            <td>@l.Employee?.FirstName</td>
                            <td>@l.FromDate.ToShortDateString()</td>
                            <td>@l.ToDate.ToShortDateString()</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .dashboard-wrapper {
        background: #f4f6fb;
        padding: 20px;
        min-height: 100vh;
    }

    .greeting {
        margin-bottom: 20px;
    }


    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        color: white;
        border-radius: 12px;
    }

        .stat-card i {
            font-size: 35px;
        }

    .blue {
        background: #2563eb;
    }

    .green {
        background: #16a34a;
    }

    .purple {
        background: #7c3aed;
    }

    .red {
        background: #dc2626;
    }

    .tables {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
        padding: 15px;
    }

    .card-header {
        font-weight: 600;
        margin-bottom: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
        border-bottom: 1px solid #eee;
    }

</style>
@code {

    int totalEmployees;
    int totalDepartments;
    int totalDesignations;
    int totalLeaves;

    List<EmployeeProtal.Domain.Entities.Employee> recentEmployees = new();
    List<LeaveRequest> recentLeaves = new();

    protected override async Task OnInitializedAsync()
    {

        totalEmployees = await Db.Employees.CountAsync();
        totalDepartments = await Db.Departments.CountAsync();
        totalDesignations = await Db.Designations.CountAsync();
        totalLeaves = await Db.LeaveRequests.CountAsync();

        recentEmployees = await Db.Employees
        .Include(e => e.Department)
        .OrderByDescending(e => e.Id)
        .Take(5)
        .ToListAsync();

        recentLeaves = await Db.LeaveRequests
        .Include(l => l.Employee)
        .OrderByDescending(l => l.Id)
        .Take(5)
        .ToListAsync();

    }

}