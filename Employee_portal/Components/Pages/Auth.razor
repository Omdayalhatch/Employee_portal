@page "/"
@layout EmptyLayout
@using EmployeeProtal.Application.DTO
@using EmployeeProtal.Application.Interface.IService
@using EmployeeProtal.Application.DTO
@using Employee_portal.Components.Layout

@inject IUserService UserService
@inject NavigationManager Navigation
<div class="container d-flex justify-content-center align-items-center" style="max-height:100vh">
    <div class="card p-4 shadow" style="width:400px">
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="text-danger text-center mt-2">@message</p>
        }
        @if (tab == 0)
        {
            
            <h3 class="text-center mb-3">Login</h3>
            
            <div class="form-group">
                <label>Email <span class="text-danger">*</span></label>
                <input class="form-control" @bind="email" />
            </div>

            <div class="form-group mt-2">
                <label>Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control" @bind="password" />
            </div>

            <button class="btn btn-primary w-100 mt-3" @onclick="HandleLogin">
                Login
            </button>

            <p class="text-center mt-3">
                Don't have an account?
                <a href="#"  @onclick="() => SetTab(1)">Register</a>
            </p>
        }

        @if (tab == 1)
        {
            <h3 class="text-center mb-3">Register</h3>

            <input class="form-control mb-2" placeholder="Username" @bind="username" />

            <input class="form-control mb-2" placeholder="Email" @bind="email" />

            <input type="password" class="form-control mb-2" placeholder="Password" @bind="password" />

            <button class="btn btn-success w-100" @onclick="HandleRegister">
                Register
            </button>

            <p class="text-center mt-3">
                Already have an account?
                <a href="#"  @onclick="() => SetTab(0)">Login</a>
            </p>
        }

        

    </div>
</div>

@code {
    private int tab = 0;
    private string username = "";
    private string email = "";
    private string password = "";
    private string message = "";
      private int roleId = 5;


    private void SetTab(int value)
    {
        tab = value;
        message = "";
    }

    private async Task HandleLogin()
    {
        try
        {
            var dto = new LoginDTO
            {
                Email = email,
                Password = password
            };

            var result = await UserService.LoginAsync(dto);

            if (result != null)
            {
                if (result. RoleId == 4 )
                    Navigation.NavigateTo("/Dashboard");
                else if (result.RoleId == 6)
                    Navigation.NavigateTo("/HR-Dashboard");
                else
                    Navigation.NavigateTo("/User-Dashboard");
            }
            else
            {
                message = "Invalid email or password";
            }
        }
        catch
        {
            message = "Login failed";
        }
    }

    private async Task HandleRegister()
    {
        try
        {
            var dto = new RegisterDTO
            {
                UserName = username,
                Email = email,
                Password = password,
                RoleId = roleId
            };

            var result = await UserService.RegisterAsync(dto);

            if (result != null)
            {
                message = "Registration successful";
                tab = 0;
            }
        }
        catch
        {
            message = "Register failed";
        }
    }
}